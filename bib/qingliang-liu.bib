@article{2018_Yang_JiYuChaoHunDunDeRBFShenJingWangLuoTuXiangZiGuaYingShuiYinSuanFa,
  title = {基于超混沌的RBF神经网络图像自适应水印算法},
  author = {Yang, Shuguo and Liu, Qingliang and Xiong, Pengcheng},
  date = {2018-09-19},
  journaltitle = {青岛科技大学学报(自然科学版)},
  volume = {39},
  number = {05},
  pages = {106-110+118},
  issn = {1672-6987},
  doi = {10.16351/j.1672-6987.2018.05.016},
  abstract = {为了更好地保护图像版权信息,本工作结合超混沌系统和RBF神经网络,提出一种基于超混沌的RBF神经网络模型加密算法,根据JND(最小可视觉误差)模型实现水印的自适应嵌入,并应用RBF神经网络进行水印信息盲检测。实验研究表明:该算法复杂度较低、容易实现,并且具有良好的安全性、不可感知性和鲁棒性。},
  langid = {chinese},
  keywords = {JND模型,RBF神经网络,盲检测,超混沌}
}

@article{2020_Liu_Discrete,
  title = {A Discrete Wavelet Transform and Singular Value Decomposition-Based Digital Video Watermark Method},
  author = {Liu, Qingliang and Yang, Shuguo and Liu, Jing and Xiong, Pengcheng and Zhou, Mengchu},
  date = {2020-09},
  journaltitle = {Applied Mathematical Modelling},
  shortjournal = {Applied Mathematical Modelling},
  volume = {85},
  pages = {273--293},
  issn = {0307-904X},
  doi = {10.1016/j.apm.2020.04.015},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0307904X20302080},
  abstract = {Digital video watermark is widely used to protect copyright and content authentication. DWT-SVD based method, i.e., discrete wavelet transform (DWT) and singular value decomposition (SVD) based method, is one of the most popular state-of-the-art methods. There are two main criteria to evaluate it, i.e., imperceptibility and robustness. The former is measured via the peak signal to noise ratio (PSNR) and structural similarity (SSIM). They should be as high as possible after the watermark is embedded. Robustness measures how easy to restore the embedded watermark by the owner even if the watermarked video is damaged by an outside attacker. Current studies randomly choose embedded positions for watermark, which hardly achieves its highest imperceptibility and robustness. In this paper, we propose a more imperceptible and robust digital video watermarking method than the existing one. First, we introduce a method to measure video frame distortion in a wavelet transform domain. Second, we model the problem to achieve the minimum video frame distortion as an optimization problem, i.e., choose embedded positions that can maximize peak signal to noise ratio. Finally, we evaluate and compare our method with the state-of-the-art approaches by using real experiments and show its advantages in both imperceptibility and robustness. \&copy; 2020 Elsevier Inc.},
  langid = {english},
  keywords = {Computer graphics,Digital watermarking - Discrete wavelet transforms - Image coding - Image compression - Image quality - Multimedia systems - Signal reconstruction - Signal to noise ratio - Singular value decomposition - Watermarking  - Wavelet decomposition}
}
