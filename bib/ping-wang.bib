@article{2023_P._Steadystate,
  title = {Steady-State Hydroelastic Waves Generated by a Moving Load in a Uniform Current},
  author = {P., Wang and D.Q., Lu and L.D., Fu},
  date = {2023-10},
  journaltitle = {Wave Motion},
  volume = {122},
  pages = {103190},
  issn = {0165-2125},
  doi = {10.1016/j.wavemoti.2023.103190},
  abstract = {Steady-state hydroelastic waves generated by a moving load with a uniform current are investigated analytically in the framework of nonlinear potential theory. Considering the load with an exponential distribution in horizontal direction, we focus on the wave dynamics characteristics when the relative current speed or the nonlinearity increases. With the aid of the homotopy analysis method (HAM), appropriate solution expressions for the unknown variables are established by comparing the relative current speed U and the minimal phase speed cmin of the hydroelastic waves. Our results demonstrate that, the wave deflection is symmetric about the load if U is much smaller than cmin. The wave deflection becomes more oscillatory and its amplitudes increase in the vicinity of the load when U increasingly approaches cmin. If U is greater than cmin, the hydroelastic waves will be generated far away from the load, and the period of the gravity waves in the downstream region are relatively larger than those of the hydroelastic waves in the upstream region. As U increases continuously, the amplitudes of gravity and hydroelastic waves all first increase and then decrease. It should be noted that there is a larger cmin of the approximate nonlinear dispersion relation than that of the linear one, and the variation of the nonlinear wave deflection would be underestimated if the linear dispersion relation is used. Finally, the graphical representations show the effects of several important physical parameters including the uniform current speed, the amplitude of incident wave, and the plate thickness on the hydroelastic waves.\& COPY; 2023 Elsevier B.V. All rights reserved.},
  langid = {english},
  keywords = {Homotopy analysis method (HAM),Moving load,Steady-state hydroelastic waves,Uniform current}
}

@article{2024_Huo_NianDanXingBanShuiDanXingXiangYingDeFeiXianXingFenXi,
  title = {黏弹性板水弹性响应的非线性分析},
  author = {Huo, Xintai and Wang, Ping},
  date = {2024-06-15},
  journaltitle = {青岛科技大学学报(自然科学版)},
  volume = {45},
  number = {03},
  pages = {147--151},
  issn = {1672-6987},
  doi = {10.16351/j.1672-6987.2024.03.020},
  abstract = {通过将超大型浮式结构物(a very large floating structure,简称VLFS)模拟为黏弹性薄板，本工作对VLFS的非线性水弹性响应进行了解析研究。运用同伦分析方法(the homotopy analysis method,简称HAM),计算出速度势和板挠度的近似迭代解，并根据计算结果着重探究了几个重要的物理参数对黏弹性板形变的影响。结果发现：黏弹性板的挠度随着黏弹性时间、杨氏模量和板厚度增加而减少，而板挠度随着入射波波幅的增加而增加。最后，还对非线性色散关系和波幅之间的联系进行了探讨。},
  langid = {chinese},
  keywords = {同伦分析方法,非线性水弹性,黏弹性板}
}
