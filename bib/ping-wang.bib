  pages = {175},
  abstract = {本文研究了垂向速度呈指数形式分布的有旋剪切流作用下浮体的非线性动力特性。引入流函数构建控制方程和非线性边界条件。对于浮体为无限长板情形,运用同伦分析方法,得到收敛的近似解析解。结果表明,顺水剪切流使得波峰更尖锐、波谷更平坦,而顺水剪切流的作用则相反;同向的行进波和剪切流使得波速增加,而波流反向时波速减小。},
  eventtitle = {第十届全国流体力学学术会议论文摘要集},
  langid = {chinese},
  keywords = {剪切流,涡量,超大型浮冰,非线性动力响应}
}

