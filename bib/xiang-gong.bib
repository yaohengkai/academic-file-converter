@inproceedings{2018_Liping_ESTIMATION,
  title = {{{ESTIMATION OF DAILY IRRADIATION EXPOSURE OF GLOBAL RADIATION USING ELMAN NEURAL NETWORK}}},
  author = {Liping, Zou and Renzheng, Wang and Shupeng, Zhuang and Chan, Lin and Shuhua, Zhang and Xiang, Gong},
