@article{2007_Song_An,
  title = {An Improvement of the Too Cold Tongue in the Tropical {{Pacific}} with the Development of an Ocean-Wave-Atmosphere Coupled Numerical Model},
  author = {Zhenya, Song and Fangli, Qiao and Yongzeng, Yang and Yeli, Yuan},
  date = {2007-05-01},
  journaltitle = {Progress in Natural Science},
  shortjournal = {Progr. Natur. Sci. (English Ed.)},
  volume = {17},
  number = {5},
  pages = {576--583},
  issn = {1002-0071},
  doi = {10.1080/10020070708541038},
  url = {http://www.tandfonline.com/doi/abs/10.1080/10020070708541038},
  abstract = {The "cold tongue" bias in the tropical Pacific is a common error in coupled general circulation models (CGCMs). We developed an ocean-wave-atmosphere coupled model by introducing the wave-induced mixing effect into the ocean component. Simulation results show that the inclusion of wave mixing deepens the mixed layer and warms the sea surface in the cold tongue region, effectively reducing the cold bias. The interactions between the waves, ocean currents, and the atmosphere creates a feedback loop that maintains a more realistic tropical Pacific mean state compared to the model without wave coupling.},
  langid = {english},
  keywords = {Air-sea interaction,Cold tongue bias,Coupled model,Tropical Pacific,Wave mixing},
  annotation = {TLDR: Generally, the wave-induced mixing lowers the SST in the OGCM because the strengthened vertical mixing can bring more cold water upward, but in the coupled model, the non-uniformity of the space distribution in SST drop generates a horizontal gradient of...}
}

@article{2009_Song_Bo,
  title = {波致混合对CCSM3气候模式预测能力的改进 (improvement of CCSM3 climate model prediction capability by wave-induced mixing)},
  author = {Song, Zhenya and Qiao, Fangli and Zhao, Wei},
  date = {2009},
  journaltitle = {自然科学进展 (Progress in Natural Science)},
  volume = {19},
  number = {2},
  pages = {203--211},
  abstract = {This study evaluates the impact of incorporating the wave-induced mixing (Bv) parameterization into the Community Climate System Model version 3 (CCSM3). Comparison between the control run and the Bv run shows that wave mixing significantly improves the simulation of the tropical ocean mean state. Specifically, it reduces the cold tongue bias in the equatorial Pacific and improves the subsurface thermal structure. The enhanced mixing also leads to a more realistic simulation of the ENSO amplitude and periodicity. The results demonstrate the necessity of coupling wave processes in global climate models.},
  langid = {chinese},
  keywords = {CCSM3,Climate prediction,Model improvement,Tropical bias,Wave-induced mixing}
}

@article{2011_Song_The,
  title = {The Correctness to the Spuriously Simulated Semi-Annual Cycle of the Sea Surface Temperature in the Equatorial Eastern {{Pacific}}},
  author = {Song, ZhenYa and Qiao, FangLi and Wang, ChunZai},
  date = {2011-03},
  journaltitle = {Science China Earth Sciences},
  shortjournal = {Sci. China Earth Sci.},
  volume = {54},
  number = {3},
  pages = {438--444},
  issn = {1674-7313},
  doi = {10.1007/s11430-011-4176-3},
  url = {http://link.springer.com/10.1007/s11430-011-4176-3},
  abstract = {Many coupled climate models produce a spurious semi-annual cycle of sea surface temperature (SST) in the equatorial eastern Pacific, whereas observations show a dominant annual cycle. This study utilizes a coupled model with an incorporated wave-induced mixing scheme to address this issue. We find that the enhanced vertical mixing provided by surface waves corrects the mixed layer depth seasonal evolution. This correction allows the model to better respond to the annual cycle of solar radiation and meridional winds, thereby suppressing the spurious semi-annual component and reproducing the realistic annual SST cycle.},
  langid = {english},
  keywords = {Climate modeling,Equatorial Pacific,Semi-annual bias,SST seasonal cycle,Wave mixing}
}

@article{2012_Song_Influence,
  title = {Influence of Parallel Computational Uncertainty on Simulations of the {{Coupled General Climate Model}}},
  author = {Zhenya, Song and Fangli, Qiao and Yongzeng, Yang and Yeli, Yuan and Song, Z. and Qiao, F. and Lei, X. and Wang, C.},
  date = {2007-05-01},
  journaltitle = {Geoscientific Model Development},
  shortjournal = {Geosci. Model Dev.},
  volume = {5},
  number = {2},
  pages = {313--319},
  issn = {1991-9603},
  doi = {10.5194/gmd-5-313-2012},
  url = {https://gmd.copernicus.org/articles/5/313/2012/},
  abstract = {Parallel computational uncertainty, arising from the non-associativity of floating-point arithmetic in parallel reductions, can introduce perturbations in climate model simulations. We investigate this effect in a coupled general circulation model. Results show that changing the parallel domain decomposition or processor count induces round-off errors that grow rapidly, leading to significant divergence in the simulated climate state after a short period. This uncertainty is comparable to that caused by initial condition perturbations. The study emphasizes the need to account for computational uncertainty when interpreting model results and performing ensemble simulations.},
  langid = {english},
  keywords = {Chaos,Climate modeling,Computational uncertainty,Parallel computing,Round-off error}
}

@article{2012_Song_Response,
  title = {Response of the Equatorial Basin‐wide {{SST}} to Non‐breaking Surface Wave‐induced Mixing in a Climate Model: {{An}} Amendment to Tropical Bias},
  author = {Song, Zhenya and Qiao, Fangli and Song, Yajuan},
  date = {2012-11},
  journaltitle = {Journal of Geophysical Research: Oceans},
  shortjournal = {J. Geophys. Res. Oceans},
  volume = {117},
  number = {C11},
  pages = {C00J26},
  issn = {0148-0227},
  doi = {10.1029/2012JC007931},
  url = {https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2012JC007931},
  abstract = {Tropical biases, such as the cold tongue bias in the Pacific and the warm bias in the Atlantic, are persistent problems in coupled climate models. This paper investigates the impact of including non-breaking wave-induced vertical mixing (Bv) in the CCSM3 model. The inclusion of Bv deepens the ocean mixed layer and warms the subsurface, which improves the simulation of the equatorial thermocline. Consequently, the cold bias in the equatorial Pacific and the warm bias in the eastern currents are alleviated. The mechanism involves the rectification of the vertical heat transport, demonstrating that wave mixing is a crucial physical process for realistic climate simulations.},
  langid = {english},
  keywords = {Climate model,Ocean mixing,SST,Tropical bias,Wave mixing}
}

@article{2014_Song_Evaluation,
  title = {Evaluation of the Eastern Equatorial {{Pacific SST}} Seasonal Cycle in {{CMIP5}} Models},
  author = {Song, Z. Y. and Liu, H. L. and Wang, C. Z. and Zhang, L. P. and Qiao, F. L.},
  date = {2019-12},
  journaltitle = {Ocean Science},
  shortjournal = {Ocean Sci.},
  volume = {10},
  number = {5},
  pages = {837--843},
  issn = {1812-0792},
  doi = {10.5194/os-10-837-2014},
  url = {https://os.copernicus.org/articles/10/837/2014/},
  abstract = {This study evaluates the simulation of the Eastern Equatorial Pacific (EEP) SST seasonal cycle in the Coupled Model Intercomparison Project Phase 5 (CMIP5). We classify the models based on their ability to reproduce the annual cycle. While some models capture the phase and amplitude correctly, a significant number still exhibit a spurious semi-annual cycle or an inverted annual cycle. We identify that the solar radiation bias and the poor representation of the cloud-SST feedback are major contributors to these errors. Comparison with CMIP3 shows moderate progress, but the EEP SST bias remains a common issue.},
  langid = {english},
  keywords = {Climate bias,CMIP5,Eastern Equatorial Pacific,Model evaluation,SST seasonal cycle}
}

@article{2015_Song_Contributions,
  title = {Contributions of the Atmosphere–Land and Ocean–Sea Ice Model Components to the Tropical {{Atlantic SST}} Bias in {{CESM1}}},
  author = {Song, Zhenya and Qiao, Fangli and Song, Yajuan and Song, Zhenya and Lee, Sang-Ki and Wang, Chunzai and Kirtman, Ben P. and Qiao, Fangli},
  date = {2015-12},
  journaltitle = {Ocean Modelling},
  shortjournal = {Ocean Model.},
  volume = {96},
  number = {2},
  pages = {280--290},
  issn = {1463-5003},
  doi = {10.1016/j.ocemod.2015.09.008},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S146350031500178X},
  abstract = {Most coupled climate models suffer from a severe warm SST bias in the eastern tropical Atlantic. In this study, we investigate the origins of this bias in the Community Earth System Model version 1 (CESM1) by separating the contributions from the atmosphere-land and ocean-sea ice components. By running partially coupled experiments, we find that the atmosphere-land component is the primary driver of the westerly wind bias, which deepens the thermocline and suppresses upwelling, initiating the warm bias. The ocean component amplifies this bias through errors in vertical mixing and advection. Correcting the atmospheric wind errors significantly reduces the SST bias.},
  langid = {english},
  keywords = {Atmosphere-ocean interaction,CESM1,Coupled model,SST error,Tropical Atlantic bias}
}

@article{2015_Song_The,
  title = {The Prediction on the 2015/16 {{El Niño}} Event from the Perspective of {{FIO-ESM}}},
  author = {Song, Zhenya and Shu, Qi and Bao, Ying and Yin, Xunqiang and Qiao, Fangli},
  date = {2015-12},
  journaltitle = {Acta Oceanologica Sinica},
  shortjournal = {Acta Oceanolog. Sin.},
  volume = {34},
  number = {12},
  pages = {67--71},
  issn = {0253-505X},
  doi = {10.1007/s13131-015-0787-4},
  url = {http://link.springer.com/10.1007/s13131-015-0787-4},
  abstract = {The 2015/16 El Niño was one of the strongest events on record. This paper reports on the real-time prediction of this event using the First Institute of Oceanography-Earth System Model (FIO-ESM) prediction system. Initialized in early 2015, the model successfully predicted the onset and rapid growth of the El Niño. We analyze the precursors captured by the model, including the westerly wind bursts and the subsurface heat content buildup. The successful prediction demonstrates the reliability of FIO-ESM in forecasting ENSO events and highlights the importance of the wave-induced mixing scheme in maintaining a realistic subsurface thermal structure.},
  langid = {english},
  keywords = {2015/16 event,Climate prediction,El Niño,ENSO forecasting,FIO-ESM}
}

@article{2017_Yang_Evaluation,
  title = {Evaluation of Three Temperature Profiles of a Sublayer Scheme to Simulate {{SST}} Diurnal Cycle in a Global Ocean General Circulation Model},
  author = {Yang, Xiaodan and Song, Zhenya and Tseng, Yu‐Heng and Qiao, Fangli and Shu, Qi},
  date = {2017-08},
  journaltitle = {Journal of Advances in Modeling Earth Systems},
  shortjournal = {J. Adv. Model. Earth Syst.},
  volume = {9},
  number = {4},
  pages = {1994--2006},
  issn = {1942-2466},
  doi = {10.1002/2017MS000927},
  url = {https://agupubs.onlinelibrary.wiley.com/doi/10.1002/2017MS000927},
  abstract = {The diurnal cycle of sea surface temperature (SST) is important for air-sea interactions but is often unresolved in ocean general circulation models (OGCMs) due to coarse vertical resolution. This study evaluates three different vertical temperature profile assumptions (linear, warm-layer, and cool-skin) within a sublayer parameterization scheme implemented in a global OGCM. We compare the simulated diurnal SST amplitudes with buoy observations. The results indicate that the scheme incorporating both the warm-layer and cool-skin effects performs best in reproducing the magnitude and phase of the diurnal cycle across different wind and solar radiation regimes.},
  langid = {english},
  keywords = {Cool skin,Diurnal SST,OGCM,Sublayer scheme,Warm layer}
}

@article{2019_Chen_Analysis,
  title = {Analysis of {{ENSO}} Simulation Biases in {{FIO-ESM}} Version 1.0},
  author = {Chen, Xingrong and Liao, Huaxia and Lei, Xiaoyan and Bao, Ying and Song, Zhenya and Song, Z. Y. and Liu, H. L. and Wang, C. Z. and Zhang, L. P. and Qiao, F. L.},
  date = {2019-12},
  journaltitle = {Climate Dynamics},
  shortjournal = {Clim. Dyn.},
  volume = {53},
  number = {11},
  pages = {6933--6946},
  issn = {1812-0792},
  doi = {10.1007/s00382-019-04969-w},
  url = {https://os.copernicus.org/articles/10/837/2014/},
  abstract = {We analyze the simulation of El Niño-Southern Oscillation (ENSO) in the First Institute of Oceanography-Earth System Model version 1.0 (FIO-ESM v1.0). The model produces a dominant 2-3 year ENSO period, shorter than the observed 3-7 years. The ENSO amplitude is weaker than observed. We trace these biases to a too strong negative feedback from the shortwave radiation and latent heat flux, and a weak thermocline feedback. The double-ITCZ bias in the model also displaces the zonal wind anomalies, weakening the ocean-atmosphere coupling. Understanding these mechanisms is key to improving ENSO simulations in future model versions.},
  langid = {english},
  keywords = {Air-sea feedback,Double-ITCZ,ENSO,FIO-ESM,Simulation bias}
}

@article{2019_Ding_An,
  title = {An Automatic Performance Model-Based Scheduling Tool for Coupled Climate System Models},
  author = {Ding, Nan and Xue, Wei and Song, Zhenya and Fu, Haohuan and Xu, Shiming and Zheng, Weimin},
  date = {2019-10},
  journaltitle = {Journal of Parallel and Distributed Computing},
  shortjournal = {J. Parallel Distrib. Comput.},
  volume = {132},
  pages = {204--216},
  issn = {0743-7315},
  doi = {10.1016/j.jpdc.2018.01.002},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S074373151830008X},
  abstract = {Coupled Climate System Models (CCSMs) are computationally intensive and consist of multiple component models with complex dependencies. Efficiently scheduling these components on supercomputers is challenging. We propose an automatic performance model-based scheduling tool designed to optimize the resource allocation and process layout for CCSMs. The tool uses historical performance data to model the scaling behavior of each component and uses a heuristic algorithm to find the optimal configuration. Validation on the Tianhe-2 supercomputer with CESM and FIO-ESM shows that the tool significantly improves the simulation speed and parallel efficiency compared to manual tuning.},
  langid = {english},
  keywords = {CESM,Climate models,High performance computing,Job scheduling,Performance modeling}
}

@article{2019_Song_FIO-ESM,
  title = {FIO-ESM v2.0模式及其参与CMIP6的方案 (FIO-ESM v2.0 model and its participation in CMIP6)},
  author = {Song, Zhenya and Bao, Ying and Qiao, Fangli},
  date = {2019},
  journaltitle = {气候变化研究进展 (Advances in Climate Change Research)},
  volume = {37},
  number = {2},
  pages = {161--170},
  doi = {10.12006/j.issn.1673-1719.2019.033},
  abstract = {The First Institute of Oceanography-Earth System Model version 2.0 (FIO-ESM v2.0) is a fully coupled climate model participating in the Coupled Model Intercomparison Project Phase 6 (CMIP6). This paper details the model components, coupling framework, and the experimental design for CMIP6. Key features of FIO-ESM v2.0 include the inclusion of surface wave non-breaking mixing, a Stokes drift effect on air-sea fluxes, and an ocean spray parameterization. The paper outlines the configuration of the DECK and other endorsed MIP experiments, providing a reference for the scientific community to use the model data.},
  langid = {chinese},
  keywords = {CMIP6,Earth system model,Experiment design,FIO-ESM v2.0,Wave mixing}
}

@article{2019_Song_Hai,
  title = {海量数据驱动下的高分辨率海洋数值模式发展与展望 (development and prospect of high-resolution ocean numerical models driven by massive data)},
  author = {Song, Zhenya and Liu, Weiguo and Liu, Xin and Su, Tianyun and Liu, Haixing and Yin, Xunqiang},
  date = {2019},
  journaltitle = {海洋科学进展 (Advances in Marine Science)},
  volume = {37},
  number = {2},
  pages = {161--170},
  doi = {10.3969/j.issn.1671-6647.2019.02.001},
  abstract = {With the rapid growth of oceanographic data and computing power, high-resolution ocean numerical modeling has entered a new era. This paper reviews the current status and future trends of high-resolution ocean models driven by massive datasets ("Big Data"). We discuss the challenges and opportunities in data assimilation, model optimization, and the integration of artificial intelligence with physical modeling. The development of exascale computing platforms enables resolving sub-mesoscale processes globally. We propose a roadmap for developing next-generation intelligent ocean prediction systems that effectively utilize multi-source observations.},
  langid = {chinese},
  keywords = {Big data,Data assimilation,Exascale computing,High-resolution model,Ocean prediction}
}

@article{2020_Song_Centuries,
  title = {Centuries of Monthly and 3-Hourly Global Ocean Wave Data for Past, Present, and Future Climate Research},
  author = {Song, Zhenya and Bao, Ying and Zhang, Danqi and Shu, Qi and Song, Yajuan and Qiao, Fangli},
  date = {2020},
  journaltitle = {Scientific Data},
  shortjournal = {Sci. Data},
  volume = {7},
  number = {1},
  pages = {226},
  issn = {2052-4463},
  doi = {10.1038/s41597-020-0566-8},
  url = {https://www.nature.com/articles/s41597-020-0566-8},
  abstract = {Ocean surface waves are essential to navigation safety, coastal activities, and climate systems. Numerical simulations are still the primary methods used in wave climate research, especially in future climate change scenarios. Recently, First Institute of Oceanography-Earth System Model version 2.0 (FIO-ESM v2.0), a global climate model coupled with an ocean wave model, was carried out the Coupled Model Intercomparison Project phase 6 (CMIP6) experiments. Here, we present the global monthly-mean and 3-hourly instantaneous wave parameter dataset from the FIO-ESM v2.0 CMIP6 experiments, including 700-year piControl, 165-year historical, three 86-year future scenarios (ssp125, ssp245, and ssp585, respectively), and two 150-year climate sensitive experiments (1pctCO2 and abrupt-4xCO2) simulations. Historical results show that the model can capture the basic wave climate features under climate change. These unique centuries of global wave data are from a fully coupled system and can provide the community with a vital long-term data source for scientific and engineering applications, such as wave climate research, wave-related process studies and parameterizations, as well as coastal and near-shore industry designs. Measurement(s) spectrum peak wave period • zero-crossing wave period • wave • height • direction Technology Type(s) computational modeling technique Factor Type(s) time-variant • geographic location Sample Characteristic - Environment climate system • ocean Sample Characteristic - Location Earth (planet) Measurement(s) spectrum peak wave period • zero-crossing wave period • wave • height • direction Technology Type(s) computational modeling technique Factor Type(s) time-variant • geographic location Sample Characteristic - Environment climate system • ocean Sample Characteristic - Location Earth (planet) Machine-accessible metadata file describing the reported data: https://doi.org/10.6084/m9.figshare.12479582},
  langid = {english},
  keywords = {Climate change,CMIP5,Data descriptor,Ocean waves,Wave data}
}

@article{2020_Song_Eastern,
  title = {Eastern Equatorial {{Pacific SST}} Seasonal Cycle in Global Climate Models: From {{CMIP5}} to {{CMIP6}}},
  author = {Song, Zhenya and Shu, Qi and Bao, Ying and Yin, Xunqiang and Qiao, Fangli and Song, Zhenya and Liu, Hailong and Chen, Xingrong},
  date = {2020-07},
  journaltitle = {Acta Oceanologica Sinica},
  shortjournal = {Acta Oceanolog. Sin.},
  volume = {39},
  number = {7},
  pages = {50--60},
  issn = {0253-505X},
  doi = {10.1007/s13131-020-1623-z},
  url = {https://link.springer.com/10.1007/s13131-020-1623-z},
  abstract = {The simulation of the sea surface temperature (SST) seasonal cycle in the eastern equatorial Pacific (EEP) is a longstanding problem in climate modeling. This study compares the performance of CMIP5 and CMIP6 models in reproducing the EEP SST annual cycle. While the multi-model mean of CMIP6 shows some improvement over CMIP5, particularly in the amplitude of the annual cycle, the semi-annual cycle bias persists in many models. We analyze the relationship between these biases and the simulation of the zonal wind stress and thermocline depth. The results suggest that improvements in the mean state dynamics are crucial for reducing the seasonal cycle errors.},
  langid = {english},
  keywords = {CMIP5,CMIP6,Eastern Equatorial Pacific,Model bias,SST seasonal cycle}
}

@article{2021_Qiu_Evaluation,
  title = {Evaluation and Projection of Global Marine Heatwaves Based on {{CMIP6}} Models},
  author = {Qiu, Zijian and Qiao, Fangli and Jang, Chan Joo and Zhang, Lujun and Song, Zhenya},
  date = {2021-12},
  journaltitle = {Deep Sea Research Part II: Topical Studies in Oceanography},
  shortjournal = {Deep Sea Res. Part II},
  volume = {194},
  pages = {104998},
  issn = {0967-0645},
  doi = {10.1016/j.dsr2.2021.104998},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0967064521000746},
  abstract = {We evaluate the simulation of historic marine heatwaves (MHWs) and project their future changes using outputs from the Coupled Model Intercomparison Project Phase 6 (CMIP6). The models generally reproduce the historical spatial patterns and statistical characteristics of MHWs, though some regional biases exist. Under future warming scenarios (SSP1-2.6, SSP2-4.5, and SSP5-8.5), MHWs are projected to become more frequent, intense, and longer-lasting globally. The most severe increases are found in the tropical oceans and the Arctic. The study emphasizes the urgency of addressing ocean warming to mitigate the ecological impacts of MHWs.},
  langid = {english},
  keywords = {Climate change,CMIP6,Marine heatwaves,Ocean warming,Projection}
}

@article{2022_Liu_An,
  title = {An Ocean Perspective on {{CMIP6}} Climate Model Evaluations},
  author = {Liu, Hailong and Song, Zhenya and Wang, Xidong and Misra, Vasu},
  date = {2022-07},
  journaltitle = {Deep Sea Research Part II: Topical Studies in Oceanography},
  shortjournal = {Deep Sea Res. Part II},
  volume = {201},
  pages = {105120},
  issn = {0967-0645},
  doi = {10.1016/j.dsr2.2022.105120},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0967064522001059},
  abstract = {This study provides a comprehensive evaluation of the ocean component simulations in the Coupled Model Intercomparison Project Phase 6 (CMIP6). We assess key oceanic indices including sea surface temperature (SST), ocean heat content (OHC), salinity, and circulation patterns across a suite of CMIP6 models. Compared to CMIP5, CMIP6 models generally show reduced biases in mean state SST and improved simulation of major current systems. However, common biases such as the double-ITCZ and cold tongue errors persist. The paper highlights the progress made in ocean modeling and identifies remaining challenges for future model development.},
  langid = {english},
  keywords = {CMIP6,Model evaluation,Ocean circulation,Ocean heat content,SST}
}

@article{2022_Song_Effects,
  title = {Effects of {{Sea Spray}} on {{Large-Scale Climatic Features}} over the {{Southern Ocean}}},
  author = {Yang, Xiaodan and Song, Zhenya and Tseng, Yu‐Heng and Qiao, Fangli and Shu, Qi and Song, Yajuan and Qiao, Fangli and Liu, Jiping and Shu, Qi and Bao, Ying and Wei, Meng and Song, Zhenya},
  date = {2022-07-15},
  journaltitle = {Journal of Climate},
  shortjournal = {J. Climate},
  volume = {35},
  number = {14},
  pages = {4645--4663},
  issn = {0894-8755},
  doi = {10.1175/JCLI-D-21-0608.1},
  url = {https://journals.ametsoc.org/view/journals/clim/35/14/JCLI-D-21-0608.1.xml},
  abstract = {The Southern Ocean, characterized by strong westerly winds and a rough sea state, exhibits the most pronounced sea spray effects. Sea spray ejected by ocean surface waves enhances heat and water exchange at the air-sea interface. However, this process has not been considered in current climate models, and the influence of sea spray on the coupled air-sea system remains largely unknown. This study incorporated a parameterization of the sea spray influence on latent and sensible heat fluxes into the First Institute of Oceanography-Earth System Model version 2.0 (FIO-ESM v2.0), a climate model coupled with an ocean surface waves component. The results indicate that the spray-mediated enthalpy flux accounted for over 20\%–50\% of the total value. Sea spray promoted ocean evaporation and heat transport, resulting in air and ocean surface cooling and strengthened westerly winds. Furthermore, a moist and stable atmosphere favored an increase in cloud fraction over the Southern Ocean, particularly low-level clouds. Increased clouds reflected downward shortwave radiation and reduced solar radiation absorption at the surface. At present, the climate models participating in phase 6 of the Coupled Model Intercomparison Project (CMIP6) still suffer notable deficiencies in reasonably reproducing the climatological features of the Southern Ocean, including warm SST and underestimated clouds biases with more absorbed shortwave radiation. Our results suggest that consideration of sea spray effects is a feasible solution to mitigate these common biases and enhance the confidence in simulations and predictions with climate models.},
  langid = {english},
  keywords = {Air-sea fluxes,Atmospheric boundary layer,Climate model,Sea spray,Southern Ocean}
}

@article{2022_Song_Liang,
  title = {两代耦合海浪的地球系统模式FIO-ESM全球碳循环过程发展 (development of global carbon cycle processes in two generations of wave-coupled earth system model FIO-ESM)},
  author = {Song, Zhenya and Bao, Ying and Qiao, Fangli},
  date = {2022},
  journaltitle = {海洋科学进展 (Advances in Marine Science)},
  volume = {40},
  number = {4},
  pages = {777--790},
  doi = {10.12362/j.issn.1671-6647.20220628001},
  abstract = {This paper reviews the development of the global carbon cycle processes in the two generations of the First Institute of Oceanography-Earth System Model (FIO-ESM v1.0 and v2.0). Both versions incorporate ocean surface wave-induced mixing, which is a unique feature of the FIO-ESM. The study compares the simulation of the carbon cycle, including air-sea CO2 fluxes and primary production, between the two versions and against observations. Improvements in physical parameterizations in v2.0 lead to a better representation of the global carbon budget. The impact of wave mixing on the vertical distribution of nutrients and carbon is also discussed.},
  langid = {chinese},
  keywords = {Carbon cycle,CO2 flux,Earth system model,FIO-ESM,Wave mixing}
}

@article{2022_Yang_Different,
  title = {Different {{Influencing Mechanisms}} of {{Two ENSO Types}} on the {{Interannual Variation}} in {{Diurnal SST}} over the {{Niño-3}} and {{Niño-4 Regions}}},
  author = {Yang, Xiaodan and Song, Yajuan and Wei, Meng and Xue, Yuhuan and Song, Zhenya},
  date = {2022-01},
  journaltitle = {Journal of Climate},
  shortjournal = {J. Climate},
  volume = {35},
  number = {1},
  pages = {125--139},
  issn = {0894-8755},
  doi = {10.1175/JCLI-D-20-0815.1},
  url = {https://journals.ametsoc.org/view/journals/clim/35/1/JCLI-D-20-0815.1.xml},
  abstract = {This study investigates how Eastern Pacific (EP) and Central Pacific (CP) El Niño events differentially impact the interannual variability of diurnal sea surface temperature (dSST) amplitudes. Using buoy observations and model outputs, we find that dSST anomalies are distinct in the Niño 3 and Niño 4 regions depending on the ENSO type. Physical analysis reveals that variations in wind speed, cloud cover, and latent heat flux control the dSST response. The distinct mechanisms identified here improve our understanding of the multi-scale interactions between the diurnal cycle and interannual climate variability.},
  langid = {english},
  keywords = {Air-sea interaction,Climate variability,Diurnal SST,ENSO diversity,Niño regions}
}

@article{2023_Jiang_Global,
  title = {Global 3-Hourly Wind-Wave and Swell Data for Wave Climate and Wave Energy Resource Research from 1950 to 2100},
  author = {Jiang, Xingjie and Xie, Botao and Bao, Ying and Song, Zhenya},
  date = {2023},
  journaltitle = {Scientific Data},
  shortjournal = {Sci. Data},
  volume = {10},
  number = {1},
  pages = {225},
  issn = {2052-4463},
  doi = {10.1038/s41597-023-02151-w},
  url = {https://www.nature.com/articles/s41597-023-02151-w},
  abstract = {We present a global dataset of 3-hourly wind-wave and swell parameters covering the period from 1950 to 2100. The dataset is generated using a wave model forced by CMIP6 multi-model ensemble winds under historical and future scenarios. It includes significant wave height, wave period, and wave direction for both total seas and separated wind-sea/swell components. Validation against altimeter and buoy data shows high correlation and low bias. This dataset provides a valuable resource for investigating long-term changes in global wave climate, extreme wave analysis, and assessing future wave energy resources under climate change.},
  langid = {english},
  keywords = {CMIP6,Dataset,Swell,Wave climate,Wave energy,Wind-wave}
}

@article{2023_Liao_Effects,
  title = {Effects of {{ITCZ Poleward Location Bias}} on {{ENSO Seasonal Phase-Locking Simulation}} in {{Climate Models}}},
  author = {Chen, Xingrong and Liao, Huaxia and Lei, Xiaoyan and Bao, Ying and Song, Zhenya and Liao, Huaxia and Cai, Zhichao and Guo, Jingsong and Song, Zhenya},
  date = {2023-08-01},
  journaltitle = {Journal of Climate},
  shortjournal = {J. Climate},
  volume = {36},
  number = {15},
  pages = {5233--5249},
  issn = {0894-8755},
  doi = {10.1175/JCLI-D-22-0891.1},
  url = {https://journals.ametsoc.org/view/journals/clim/36/15/JCLI-D-22-0891.1.xml},
  abstract = {El Niño and the Southern Oscillation (ENSO) is the most influential interannual climate variability on Earth. The tendency of the mature phase of ENSO, characterized by the strongest sea surface temperature (SST) anomalies, to appear during the boreal winter is known as seasonal phase locking. Climate models are challenged by biases in simulating ENSO seasonal phase-locking. Here, we evaluated the ENSO phase-locking simulation performance in 50 Coupled Model Intercomparison Project Phase 6 (CMIP6) models, and found that the models with the Intertropical Convergence Zone (ITCZ) poleward bias tended to simulate more ENSO events that peaked out of the boreal winter season. The contributions of the ITCZ poleward bias to the ENSO phase-locking bias were also evaluated, yielding a correlation coefficient of 0.55, which can explain approximately 30\% of the ENSO seasonal phase-locking bias. The mechanism that influences the simulation of ENSO seasonal phase-locking was also assessed. The ITCZ poleward bias induces a dry bias over the equatorial Pacific, especially during the boreal summer. During ENSO events, the meridional movement of the ITCZ is prevented, and the equatorial precipitation and convection anomalies that respond to ENSO events are also restrained. The restrained convection anomaly weakens the ENSO-related zonal wind anomaly, triggering a weaker eastern tropical Pacific thermocline anomaly during the following autumn. The weakened thermocline anomaly cannot sustain further development of ENSO-related SST anomalies. Therefore, ENSO events in models containing ITCZ poleward bias are restrained during the boreal summer and autumn and, thus, tend to peak out of the winter season.},
  langid = {english},
  keywords = {Bjerknes feedback,Climate model bias,ENSO,ITCZ,Phase-locking}
}

@article{2023_Yang_Key,
  title = {Key to {{ENSO}} Phase-Locking Simulation: Effects of Sea Surface Temperature Diurnal Amplitude},
  author = {Yang, Xiaodan and Bao, Ying and Song, Zhenya and Shu, Qi and Song, Yajuan and Wang, Xin and Qiao, Fangli},
  date = {2023},
  journaltitle = {npj Climate and Atmospheric Science},
  shortjournal = {npj Clim Atmos Sci},
  volume = {6},
  number = {1},
  pages = {159},
  issn = {2397-3722},
  doi = {10.1038/s41612-023-00483-3},
  url = {https://www.nature.com/articles/s41612-023-00483-3},
  abstract = {El Niño-Southern Oscillation (ENSO) phase-locking, the tendency of ENSO events to peak in boreal winter, remains a challenge for many climate models. This study reveals that the simulation of ENSO phase-locking is sensitive to the representation of sea surface temperature (SST) diurnal amplitude. By incorporating a parameterization for diurnal SST variations, the model better reproduces the seasonal cycle of the coupled instability in the tropical Pacific. The results demonstrate that accurate simulation of the diurnal cycle rectifies the mean state and seasonal evolution of the air-sea system, thereby improving the phase-locking behavior of ENSO events.},
  langid = {english},
  keywords = {Climate modeling,Diurnal SST,ENSO,Phase-locking,Tropical Pacific}
}

@article{2024_Jin_GWSM4C,
  title = {{{GWSM4C}}: {{A}} Global Wave Surrogate Model for Climate Simulation Based on a Convolutional Architecture},
  author = {Jin, Quan and Jiang, Xingjie and Hua, Feng and Yang, Yongzeng and Jiang, Shumin and Yu, Chen and Song, Zhenya},
  date = {2024-10},
  journaltitle = {Ocean Engineering},
  shortjournal = {Ocean Eng.},
  volume = {309},
  pages = {118458},
  issn = {0029-8018},
  doi = {10.1016/j.oceaneng.2024.118458},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0029801824017967},
  abstract = {Ocean waves are a critical component of the Earth system, yet directly coupling wave models in climate simulations is computationally expensive. We introduce GWSM4C, a Global Wave Surrogate Model designed for climate simulations using a convolutional neural network architecture. GWSM4C efficiently emulates the behavior of numerical wave models, predicting global wave parameters with high accuracy and a fraction of the computational cost. Validation against numerical model outputs confirms that GWSM4C captures the global wave climate patterns, seasonal variability, and extreme wave events, making it a viable alternative for long-term climate studies requiring wave-atmosphere-ocean interactions.},
  langid = {english},
  keywords = {Climate simulation,Convolutional neural network,Deep learning,Ocean waves,Wave surrogate model}
}

@article{2024_Shu_Description,
  title = {Description of {{FIO-ESM}} Version 2.1 and Evaluation of Its Sea Ice Simulations},
  author = {Shu, Qi and Qiao, Fangli and Liu, Jiping and Bao, Ying and Song, Zhenya},
  date = {2024-02},
  journaltitle = {Ocean Modelling},
  shortjournal = {Ocean Model.},
  volume = {187},
  pages = {102308},
  issn = {1463-5003},
  doi = {10.1016/j.ocemod.2023.102308},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S1463500323001488},
  abstract = {This paper presents the description of the First Institute of Oceanography-Earth System Model version 2.1 (FIO-ESM v2.1) and evaluates its performance in simulating sea ice. FIO-ESM v2.1 incorporates several improvements over its predecessor, including upgraded physical parameterizations and component models. The evaluation focuses on the seasonal cycle, spatial distribution, and interannual variability of Arctic and Antarctic sea ice. The results show that FIO-ESM v2.1 significantly reduces biases in sea ice extent and thickness compared to observations and reanalysis data. The inclusion of wave-induced mixing and other wave-related processes plays a crucial role in improving the simulation of sea ice dynamics and thermodynamics.},
  langid = {english},
  keywords = {Climate model,Evaluation,FIO-ESM v2.1,Ocean modelling,Sea ice}
}

@article{2024_Song_Role,
  title = {Role of {{Strong Sea Surface Temperature Diurnal Variation}} in {{Triggering}} the {{Summer Monsoon Onset Over}} the {{Bay}} of {{Bengal}} in a {{Climate Model}}},
  author = {Song, Yajuan and Yang, Xiaodan and Bao, Ying and Qiao, Fangli and Song, Zhenya},
  date = {2024-08-16},
  journaltitle = {Geophysical Research Letters},
  shortjournal = {Geophys. Res. Lett.},
  volume = {51},
  number = {15},
  pages = {e2023GL108015},
  issn = {0094-8276},
  doi = {10.1029/2023GL108015},
  url = {https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2023GL108015},
  abstract = {The onset of the Bay of Bengal (BoB) summer monsoon is a critical climatic event. This study investigates the impact of diurnal sea surface temperature (SST) variations on the monsoon onset using a climate model. We find that strong diurnal SST amplitudes in the BoB prior to the monsoon onset enhance the surface latent heat flux and atmospheric instability. This process facilitates the convection organization and northward propagation of the monsoon rainband. Sensitivity experiments confirm that resolving the diurnal SST cycle in the model significantly improves the timing and intensity of the simulated monsoon onset, highlighting the importance of high-frequency air-sea interactions.},
  langid = {english},
  keywords = {Air-sea interaction,Bay of Bengal,Climate modeling,Diurnal SST,Summer monsoon}
}

@article{2024_Wu_GSDNet,
  title = {{{GSDNet}}: {{A}} Deep Learning Model for Downscaling the Significant Wave Height Based on {{NAFNet}}},
  author = {Wu, Xiaoyu and Zhao, Rui and Chen, Hongyi and Wang, Zijia and Yu, Chen and Jiang, Xingjie and Liu, Weiguo and Song, Zhenya},
  date = {2024-04},
  journaltitle = {Journal of Sea Research},
  shortjournal = {J. Sea Res.},
  volume = {198},
  pages = {102482},
  issn = {1385-1101},
  doi = {10.1016/j.seares.2024.102482},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S1385110124000157},
  abstract = {Accurate wave height information is essential for marine engineering and safety. This study proposes GSDNet, a deep learning model based on the Nonlinear Activation Free Network (NAFNet), for downscaling significant wave height (SWH). The model is designed to generate high-resolution wave fields from low-resolution inputs. Experiments demonstrate that GSDNet outperforms traditional interpolation methods and other deep learning architectures in terms of accuracy and computational efficiency. The model successfully reconstructs fine-scale wave features and shows robust performance across different sea states, providing a powerful tool for obtaining high-resolution wave data.},
  langid = {english},
  keywords = {Deep learning,Downscaling,GSDNet,NAFNet,Significant wave height}
}

@article{2025_Wang_Assessment,
  title = {Assessment of the Marine Heatwaves Prediction Performance of the Short-Term Climate Prediction System {{FIO-CPS}} v2.0},
  author = {Wang, Yuanlin and Song, Yajuan and Bao, Ying and Jang, Chan Joo and Song, Zhenya},
  date = {2025-06},
  journaltitle = {Weather and Climate Extremes},
  shortjournal = {Weather Clim. Extremes},
  volume = {48},
  pages = {100757},
  issn = {2212-0947},
  doi = {10.1016/j.wace.2025.100757},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S2212094725000155},
  abstract = {Marine heatwaves (MHWs) are extreme coherent ocean temperature events that can have devastating impacts on marine ecosystems and socio-economies. This study assesses the prediction performance of the First Institute of Oceanography-Climate Prediction System version 2.0 (FIO-CPS v2.0) for MHWs. The results indicate that FIO-CPS v2.0 demonstrates skillful prediction capabilities for global MHWs, particularly in the tropics. The system effectively captures the spatial distribution and temporal evolution of sea surface temperature anomalies associated with MHW events. Evaluation metrics including intensity, duration, and frequency show that the model provides valuable lead times for early warning systems, although challenges remain in high-latitude regions and western boundary currents.},
  langid = {english},
  keywords = {Climate model,FIO-CPS v2.0,Marine heatwaves,Prediction,SST}
}
