  keywords = {ASSOCIATION,BETA-AMYLOIDOSIS,COGNITIVE DECLINE,DEFINITION,DISEASE,HYPOTHETICAL MODEL,INDIVIDUALS,NEURODEGENERATION,PREVALENCE,TRAJECTORIES}
