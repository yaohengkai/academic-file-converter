  volume = {43},
  number = {04},
  pages = {120--126},
  issn = {1672-6987},
  doi = {10.16351/j.1672-6987.2022.04.016},
  abstract = {提出了一种基于深度卷积神经网络的海洋多目标涡旋检测方法。首先利用改进的密集卷积精确提取海洋涡旋特征，并使用跨层融合技术提高特征的利用率，来充分捕捉边缘信息；然后结合转置卷积和跳过连接构建上采样路径得到检测结果，以获得更高的检测准确率；最后在CMEMS(哥白尼海洋环境监测服务中心)发布的公开数据集上对本工作提出的方法进行了对比实验，实验结果表明：与EddyNet、PET等方法相比，本工作的方法能够有效分离、检测出距离较近的涡旋，具有更好的检测结果。},
  langid = {chinese},
  keywords = {海洋涡旋,深度学习,特征融合,目标检测}
}

@article{2023_Guo_XinShiDaiQiangJunMuBiaoDeLiLunNeiHanYuShiDaiJieZhi,
  title = {新时代强军目标的理论内涵与时代价值},
