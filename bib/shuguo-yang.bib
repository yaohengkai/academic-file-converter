@article{2007_Li_GaoDengShuXueFenCengCiJiaoXueDeTanSuoYuShiJian,
  title = {高等数学分层次教学的探索与实践},
  author = {Li, Chunxia and Yang, Shuguo},
  date = {2007-09-30},
  journaltitle = {教育与现代化},
  volume = {84},
  number = {03},
  pages = {30--35},
  issn = {1007-3051},
  abstract = {随着招生规模的不断扩大,各高校学生的整体素质有所下降,并且个体差异很大,这给高等数学教学带了前所未有的难度,为了改变这一现状,一些院校开展了分层次教学改革的尝试,笔者根据多年来分层次教学改革的经验,深入探讨了高等数学分层次教学的必要性、意义、具体实施方案等,提出了建设性的对策和建议,并对自己的教学实践进行了详细的总结和分析。},
  langid = {chinese},
  keywords = {分层次教学,因材施教,数学教学改革}
}

@inproceedings{2007_Yang_Fractal,
  title = {A Fractal Watermarking Scheme for Image in {{DWT}} Domain},
  author = {Yang, Shuguo and Li, Chunxia and Sun, Shenghe and Xie, Rongsheng},
  date = {2007},
  pages = {364-+},
  abstract = {The scheme in this paper carries out embedding and detecting of watermarking by the fractal technology in DWT domain. This method introduces the threshold control, searches for the self-similar domain subtrees by the fractal transforms and let the domain subtrees to be the watermarking embedding trees. The watermarking signals are embedded and detected according to the JND model. A large number of attacking experiments prove that security and the robustness of the method.},
  eventtitle = {{{SNPD}} 2007: {{EIGHTH ACIS INTERNATIONAL CONFERENCE ON SOFTWARE ENGINEERING}}, {{ARTIFICIAL INTELLIGENCE}}, {{NETWORKING}}, {{AND PARALLEL}}/{{DISTRIBUTED COMPUTING}}, {{VOL}} 1, {{PROCEEDINGS}}},
  langid = {english}
}

@inproceedings{2007_Yang_Image,
  title = {Image Double Encryption Method Based on Chaotic Map and {{DWT}}},
  author = {Yang, Shuguo and Sun, Shenghe and Li, Chunxia},
  date = {2007},
  pages = {540--543},
  abstract = {Image encryption becomes more and more important with the development of the network technology and the multimedia technology. A novel and secure image encryption method based on Chaos map and DWT is described at length in the paper. Firstly, we introduce two coupling chaotic maps to scramble an original image, and receive the scrambled image. Secondly, we transform the scrambled image by DWT. At the same time, we introduce a chaotic map again, and then we encrypt the wavelet coefficients of the scrambled image in DWT domain. In the whole process we use three chaotic maps, five keys and encrypt the image twice. Finally, we do many experiments and the experimental results prove our method to be secure.},
  eventtitle = {{{DCABES}} 2007 {{Proceedings}}, {{Vols I}} and {{II}}},
  langid = {english},
  keywords = {chaotic map,DWT,image encryption,image scrambling,secret key}
}

@inproceedings{2007_Yang_Research,
  title = {Research on Video Watermarking Scheme Based on Chaos, {{DWT}} and {{JND}} Model},
  author = {Yang, Shuguo and Sun, Shenghe and Li, Chunxia},
  date = {2007},
  pages = {926-+},
  abstract = {The paper presents a novel and robust video watermarking scheme for copyright protection based on chaos, DWT and JND model of HVS. Firstly, in order to ensure security of watermarking and reduce the quantity of computation in the embedding process, we adopt a technique called chaotic selection to select the embedding frames from the video. To every selected frame, we transform it by DWT and detect the variation status of the coefficient in low frequency domain. Because HVS isn't too sensitive to the motive things, we choose those coefficients whose variations are large as the embedding coefficients. Finally, the watermarking signals are embedded and detected according to the JND model. The experimental results show that the proposed watermarking algorithm is robust to additive noise, MPEG compression, frame deleting and so on.},
  eventtitle = {{{CIS}}: 2007 {{INTERNATIONAL CONFERENCE ON COMPUTATIONAL INTELLIGENCE AND SECURITY}}, {{PROCEEDINGS}}},
  langid = {english}
}

@inproceedings{2007_Yang_Robust,
  title = {A Robust {{3D}} Model Watermarking Scheme Based on Feature Recognition},
  author = {Yang, Shuguo and Li, Chunxia and Sun, Shenghe and Xu, Yaoqun},
  date = {2007},
  pages = {989-+},
  abstract = {Copyright protection becomes a more and more important problem with the development of the creation and distribution of 3D model. The paper proposes a novel and robust watermarking scheme for 3D model based on the feature recognition method. Firstly, we construct the Cartesian coordinates in 3D model and extract six 2D images from six different directions according to the habit of human recognition. Secondly, We divide the images into 8 x 8 blocks and transform them in DCT domain, then embed the watermark into the middle-frequency coefficients according to the JND model of the human visual system. Finally, we retrieve the 3D model which is embedded the watermark into. The watermarking detection process is averse to the watermarking embedding process. Many experimental results show that this watermarking scheme is imperceptible, robust and able to withstand common attacks on 3D models such as mesh simplification, adding noise, model cropping.},
  eventtitle = {{{SNPD}} 2007: {{EIGHTH ACIS INTERNATIONAL CONFERENCE ON SOFTWARE ENGINEERING}}, {{ARTIFICIAL INTELLIGENCE}}, {{NETWORKING}}, {{AND PARALLEL}}/{{DISTRIBUTED COMPUTING}}, {{VOL}} 3, {{PROCEEDINGS}}},
  langid = {english}
}

@inproceedings{2007_Yang_Robusta,
  title = {A Robust {{3D}} Model Watermarking Scheme Based on the Normal Vector Angle},
  author = {Yang, Shuguo and Sun, Shenghe and Li, Chunxia},
  date = {2007},
  pages = {413--416},
  abstract = {Copyright protection becomes a more and more important issue with the rapid development of the creation of 3D model. The paper proposes a novel robust watermarking scheme for 3D model based on the normal vector angles of the triangles in 3D model. Firstly, we construct the Cartesian coordinates system of 3D model, calculate the unit normal vectors at the center points of the triangles and the angles of the unit normal vectors. Then we regard the large angles as the embedding angles to embed the watermark. Finally, many attacking experimental results verify that the proposed algorithm is imperceptible and robust against common attacks such as simplifications, adding noise, and model cropping.},
  eventtitle = {{{PROGRESS IN INTELLIGENCE COMPUTATION AND APPLICATIONS}}, {{PROCEEDINGS}}},
  langid = {english},
  keywords = {normal vector angle,watermarking scheme}
}

@inproceedings{2007_Yang_Text,
  title = {Text Information Hiding Method. Based on Chaotic Map and {{BCH}} Code in {{DWT}} Domain of a Carrier Image},
  author = {Yang, Shuguo and Li, Chunxia and Sun, Shenghe},
  date = {2007},
  pages = {239-+},
  abstract = {The issue of Information security in the transmit process becomes more and more urgent with the development of the network technology and the information technology. A novel scheme for text information hiding is proposed in the paper. Firstly, we encode the characters of the text information by ASCII code and receive plaintext information codes. Secondly, we encrypt the plaintext information codes by chaotic encryption method and receive encryption information codes. Then we encode the encrypted information codes by BCH code again before we transmit them, and embed the ciphertext informaiion into the selected wavelet coefficients of a carrier image in DWT domain. Finally, we do many experiments to prove our scheme to be secure and robust.},
  eventtitle = {{{PROCEEDINGS OF THE FIRST INTERNATIONAL SYMPOSIUM ON DATA}}, {{PRIVACY}}, {{AND E-COMMERCE}}},
  langid = {english}
}

@inproceedings{2007_Yang_Texta,
  title = {Text Information Hiding Method Based on Chaotic Map and {{BCH}} Code in {{DWT}} Domain of a Carrier Image},
  author = {Yang, Shuguo and Li, Chunxia and Sun, Shenghe},
  date = {2007},
  pages = {1754-+},
  abstract = {The issue of Information security in the transmitting process becomes more and more urgent with the development of the network technology and the information technology. A novel scheme for text information hiding is proposed in the paper. We do Many works to text information before embedding them into a carrier image. Firstly, we encode the characters of the text information by ASCH code and receive plaintext information codes. Secondly, we encrypt the plaintext information codes by chaotic encryption method and receive encrypted information codes. Then we encode the encrypted information codes by BCH code again before we transmit them, and embed the ciphertext information into the selected wavelet coefficients of a carrier image in DWT. Finally, we do many experiments to Prove our scheme to be secure and robust.},
  eventtitle = {2007 {{INTERNATIONAL CONFERENCE ON WAVELET ANALYSIS AND PATTERN RECOGNITION}}, {{VOLS}} 1-4, {{PROCEEDINGS}}},
  langid = {english},
  keywords = {ASCII code,BCH code,chaotic map,DWT,text information}
}

@article{2008_Yang_JiYuXiaoBoYuFenXingBianHuanDeTuXiangShuiYinJiShu,
  title = {基于小波域分形变换的图像水印技术},
  author = {Yang, Shuguo},
  date = {2008-06-15},
  journaltitle = {青岛科技大学学报(自然科学版)},
  volume = {112},
  number = {03},
  pages = {261--265},
  issn = {1672-6987},
  abstract = {为了提高图像水印的鲁棒性和不可见性,结合小波变换和分形变换,提出了一种基于小波域内分形变换的图像数字水印方法。首先对图像进行小波变换,结合图像空域分形编码思想把图像的小波系数分成域子树和值子树两类,然后利用分形仿射变换选出具有相似性的域子树,将其作为水印的嵌入树,结合人类视觉系统的JND模型实现水印的嵌入和提取,最后针对该方法进行了JPEG压缩、剪切、滤波、添加噪声、旋转等相关实验,结果表明,该方法具有安全可靠、鲁棒性和不可见性好等优点,具有创新,可行性强。},
  langid = {chinese},
  keywords = {分形理论,数字水印,离散小波变换}
}

@article{2008_Yang_Video,
  title = {A Video Encryption Method Based on Chaotic Maps in {{DCT}} Domain},
  author = {Yang, Shuguo and Sun, Shenghe},
  date = {2008-10},
  journaltitle = {ISA Transactions},
  shortjournal = {ISA Transactions},
  volume = {18},
  number = {10},
  pages = {1299--1304},
  issn = {0019-0578},
  doi = {10.1016/j.pnsc.2008.05.009},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0019057823005591},
  abstract = {This paper proposes a new and secure video encryption method based on chaotic maps in DCT domain, which is quite in keeping with the common ideas and the frequent practices of video encryption. We select the I-frames of the video sequence as encryption objects. First, we introduce two coupling chaotic maps to scramble the DCT coefficients of every original I-frame, and receive the scrambled I-frame. Second, we encrypt the DCT coefficients of the scrambled I-frame using another chaotic map. In the whole process, we use three chaotic maps and five keys' the I-frame is encrypted twice. Finally, we performed several tests and the experimental results have proved our method to be secure and efficient. (C) 2008 National Natural Science Foundation of China and Chinese Academy of Sciences. Published by Elsevier Limited and Science in China Press. All rights reserved.},
  langid = {english},
  keywords = {Chaotic map,I-frame,Scrambling,Video encryption,Video sequence}
}

@article{2009_Li_TuXiangHunDunZhiLuanJiJiaMiFangFa,
  title = {图像混沌置乱及加密方法},
  author = {Li, Chunxia and Yang, Shuguo},
  date = {2009-02-15},
  journaltitle = {青岛科技大学学报(自然科学版)},
  volume = {30},
  number = {01},
  pages = {80--83},
  issn = {1672-6987},
  abstract = {提出了一种新的图像混沌置乱及加密的方法,首先利用2个耦合混沌映射产生一系列混沌序列对,利用该序列对形成图像像素新的地址码,对原始图像进行混沌置乱,从而得到乱序图像;其次对乱序图像进行DCT,在DCT域内再利用一个混沌序列对每一个系数进行自适应的改变,完成对图像的加密过程,图像的解密和反置乱过程与上述过程正好相反。为了验证本方法的安全性和可靠性,对其进行了仿真实验和效果分析,结果表明,该方法简单易行,安全可靠,可操作性强。},
  langid = {chinese},
  keywords = {混沌加密,混沌映射,混沌置乱,耦合映射,解密}
}

@inproceedings{2009_Yang_Research,
  title = {Research on {{Fractal Watermarking Method}} for {{Video}} Based on {{DCT}} and {{JND Model}}},
  author = {Yang, Shuguo},
  date = {2009},
  pages = {66--68},
  abstract = {The paper presents a novel and robust video watermarking scheme based on fractal theory in DCT domain of every I-frame of video stream. Firstly, we select I-frames from video stream as objects to embed watermarks. Before watermarking embedding, we divide every I-frame into range block pool and domain block pool in DCT domain. Secondly, we search for embedding blocks from range block pool according to the fractal theoretic. Finally watermarks are embedded into the embedding blocks and detected according to JND model. Some tests prove this method to be robust, simple and easy to use.},
  eventtitle = {{{PROCEEDINGS OF INTERNATIONAL SYMPOSIUM ON IMAGE ANALYSIS}} \& {{SIGNAL PROCESSING}}, 2009},
  langid = {english},
  keywords = {DCT,fractal theory,JND model,range block pool,video watermarking}
}

